#init blib
source blib
b_checkVersion 1 6 || { >&2 echo "This script depends on blib (https://github.com/3hhh/blib) version 1.6 or higher. Please install a supported version." ; exit 1 ; }
eval "$B_SCRIPT"
b_import "types"
b_import "os/qubes4/dom0"

#distinguish the B_E exit code from the "normal" error
B_RC=6
B_DOM0_QVM_RUN_PARAMS=("--no-gui")

#helper array for execVMFunc
declare -a VM_FUNCTIONS=()

#name and user of the audio VM to work with, initialized in main()
AUDIO_VM=""
AUDIO_USER=""

function usage {
echo "$B_SCRIPT_NAME mute [vm]|unmute [vm]|toggle [vm]|printDefault|switchOut|switchIn|volumeOut [volume]|volumeIn [volume]

dom0 script to execute the given action for the given VM (assumes pipewire in your audio VM).

If no VM is specified, the given command is executed for all running VMs.

mute [vm]: Mute the given VM. default can be used to mute the default outputs and inputs.
unmute [vm]: Unmute the given VM. default can be used to unmute the default outputs and inputs.
toggle [vm]: Toggle the mute status of the given VM. default can be used to toggle the default outputs and inputs.
printDefault: Print the current default audio output & input.
switchOut: Switch the the default audio output to the next available output.
switchIn: Switch the the default audio input to the next available input.
volumeOut [volume]: Set the volume of the default output to the given value.
volumeIn [volume]: Set the volume of the default input to the given value.
app: Start the volume control app.
"
exit 1
}

#execVMFunc [function] [parameters]
#Executes the given vm_ function inside the audio VM. Passes the _UNSAFE_ VM stdout to dom0.
#returns: Whatever the function returns. Unsafe!!! Use b_types_str or similar methods to sanitize it.
#@B_E
function execVMFunc {
local func="$1"
shift

#execute locally, if dom0 is used as audio VM
if [[ "$AUDIO_VM" == "dom0" ]] ; then
  ( "$func" "$@" ) || { B_ERR="Failed to execute $func. See the previous output for details." ; B_E ; }
fi

#initialize the list of functions to pass to the backup VM (if needed)
if [ ${#VM_FUNCTIONS[@]} -eq 0 ] ; then
	local re='^declare -f (vm_.*)$'
	while b_readLine ; do
		[[ "$B_LINE" =~ $re ]] && VM_FUNCTIONS+=("${BASH_REMATCH[1]}")
	done <<< "$(declare -F)"
fi

b_dom0_execFuncIn "$AUDIO_VM" "$AUDIO_USER" "$func" - "${VM_FUNCTIONS[@]}" - "$@"
}

#checkDependencies
#Checks whether the current bash environment suffices the dependency requirements to run this script.
#returns: Nothing, but errors out, if the dependencies are not met.
#@B_E
function checkDependencies {
b_deps "qvm-prefs" "qubes-prefs" "qvm-ls" "grep"

#the VM dependencies are checked on first execution
b_dom0_setVMDeps "wpctl
pavucontrol"
}

#vm_get_ids [vm]
function vm_get_ids {
local vm="$1"
local info=
info="$(wpctl status)" || { B_ERR="Failed to execute wpctl status." ; B_E ; }

if [[ "$vm" == "default" ]] ; then
  #special case: default inputs & sinks marked with a *
  local re='^.*\*[ ]*([0-9]+)\.[ ]*(.*)$'

  while IFS= read -r line || [ -n "$line" ] ; do
    if [[ "$line" =~ $re ]] ; then
      echo "${BASH_REMATCH[1]}"
    fi
  done <<< "$info"
else
  #regular VMs

  #get the ID for the given VM
  local id_regex='^[ ]*([0-9]+)\.[ ]*([^ ]+)[ ]+.*$'
  local line id

  local found=1
  while IFS= read -r line || [ -n "$line" ] ; do
    #ignore everything until "Streams:"
    [[ "$line" == *"Streams:"* ]] && found=0
    [ $found -eq 0 ] || continue

    if [[ "$line" =~ $id_regex ]] ; then
      [[ "${BASH_REMATCH[2]}" == "$vm" ]] && echo "${BASH_REMATCH[1]}"
    fi
  done <<< "$info"
fi
return 0
}

#vm_setMute [wpcmd] [vm list]
function vm_setMute {
local wpcmd="$1"
local vms="$2"

local vm=
local errs=""
while IFS= read -r vm || [ -n "$vm" ] ; do
  local vm_ids=
  vm_ids="$(vm_get_ids "$vm")"
  [ -z "$vm_ids" ] && errs="$errs"$'\n'"Failed to get the ID for the VM $vm." && continue

  local id=
  while IFS= read -r id || [ -n "$id" ] ; do
    wpctl set-mute "$id" "$wpcmd" || errs="$errs"$'\n'"Failed to execute $wpcmd for the VM $vm on ID $id."
  done <<< "$vm_ids"
done <<< "$vms"

echo "${cmd}d:"
echo "$vms"
[ -z "$errs" ] || { B_ERR="$errs" ; B_E ; }
}

function setMute {
local cmd="$1"
local vms="$2"
if [[ "$cmd" == "mute" ]] ; then
  wpcmd="1"
elif [[ "$cmd" == "unmute" ]] ; then
  wpcmd="0"
elif [[ "$cmd" == "toggle" ]] ; then
  wpcmd="toggle"
else
  B_ERR="Invalid command: $cmd"
  B_E
fi

if [ -z "$vms" ] ; then
  vms="$(set -e -o pipefail ; qvm-ls --running -O NAME --raw-list | grep -Ev "^dom0$")" || { B_ERR="Failed to execute qvm-ls." ; B_E ; }
fi

b_silence execVMFunc "vm_setMute" "$wpcmd" "$vms"
}

function vm_printDefault {
local skip="${1:--1}"
local field="${2:-2}"
local info="$3"
if [ -z "$info" ] ; then
  info="$(wpctl status)" || { B_ERR="Failed to execute wpctl." ; B_E ; }
fi

local re='^.*\*[ ]*([0-9]+)\.[ ]*(.* \[.*\])$'
local line=
local found=1
while IFS= read -r line || [ -n "$line" ] ; do
  if [[ "$line" =~ $re ]] ; then
    [ $skip -gt 0 ] && skip=$(( $skip -1 )) && continue
    found=0
    echo "${BASH_REMATCH[$field]}"
    [ $skip -eq 0 ] && exit $found
  fi
done <<< "$info"
exit $found
}

function printDefaultNice {
local out=
out="$(b_types_str execVMFunc vm_printDefault)" || { B_ERR="Failed to execute wpctl inside the audio VM." ; B_E ; }
echo "Out: ${out/$'\n'/$'\nIn:  '}"
}

function vm_switch {
local info=
info="$(wpctl status)" || { B_ERR="Failed to execute wpctl." ; B_E ; }
local section="$1"

#try to find the relevant section in the info
local line
local re='^[^0-9]*([0-9]+)\..*$'
local foundSection=1
local sectionContent=""
while IFS= read -r line || [ -n "$line" ] ; do
  if [ $foundSection -eq 0 ] ; then
    [[ "$line" =~ $re ]] && sectionContent="$sectionContent"$'\n'"$line" || break
  else
    [[ "$line" == *"$section"* ]] && foundSection=0
  fi
done <<< "$info"
[ -z "$sectionContent" ] && { B_ERR="Couldn't find the section $section inside $info. Did the wpctl output change?!" ; B_E ; }

#get the first line and the line after the default
local next=1
local first=0
local firstId=""
local nextId=
while IFS= read -r line || [ -n "$line" ] ; do
  [ $first -eq 0 ] && [[ $line =~ $re ]] && firstId="${BASH_REMATCH[1]}" && first=1
  [ $next -eq 0 ] && [[ $line =~ $re ]] && nextId="${BASH_REMATCH[1]}" && break
  [[ "$line" == *'*'* ]] && next=0 #default found
done <<< "$sectionContent"

[ -z "$nextId" ] && nextId="$firstId"
wpctl set-default "$nextId"
}

function vm_volume {
local skip="$1"
shift
local curId=
curId="$(vm_printDefault "$skip" 1)" || { B_ERR="Failed to retrieve the ID of the current default device." ; B_E ; }
wpctl set-volume -l 1.0 "$curId" "$@"
}

function vm_app {
pavucontrol
}

#initAudioVars [vm]
#Initialize AUDIO_VM & AUDIO_USER. If not VM is specified, use the default audio VM.
#@B_E
function initAudioVars {
local vm="$1"

if [ -n "$vm" ] ; then
  AUDIO_VM="$(qvm-prefs "$vm" "audiovm")" || { B_ERR="Failed to identify the audiovm for the VM $vm." ; B_E ; }
  [ -z "$AUDIO_VM" ] && B_ERR="No audiovm property set for the VM $vm." && B_E
else
  AUDIO_VM="$(qubes-prefs "default_audiovm")" || { B_ERR="Failed to retrieve the default_audiovm ." ; B_E ; }
  [ -z "$AUDIO_VM" ] && B_ERR="No default_audiovm property set." && B_E
fi

AUDIO_USER="$(qvm-prefs "$AUDIO_VM" "default_user")" || { B_ERR="Failed to identify the $AUDIO_VM user." ; B_E ; }
[ -z "$AUDIO_USER" ] && B_ERR="No default_user for the VM $AUDIO_VM found." && B_E
}

function main {
  [ $# -lt 1 ] && usage
  [ $# -gt 2 ] && usage

  checkDependencies

  local cmd="$1"
  shift
  if [[ "$cmd" =~ ^(mute|unmute|toggle) ]] ; then
    initAudioVars "$2"
    setMute "$cmd" "$@"
  elif [[ "$cmd" == "printDefault" ]] ; then
    initAudioVars
    printDefaultNice
  elif [[ "$cmd" == "switchOut" ]] ; then
    initAudioVars
    b_silence execVMFunc "vm_switch" "Sinks:"
  elif [[ "$cmd" == "switchIn" ]] ; then
    initAudioVars
    b_silence execVMFunc "vm_switch" "Sources:"
  elif [[ "$cmd" == "volumeOut" ]] ; then
    initAudioVars
    b_silence execVMFunc "vm_volume" 0 "$@"
  elif [[ "$cmd" == "volumeIn" ]] ; then
    initAudioVars
    b_silence execVMFunc "vm_volume" 1 "$@"
  elif [[ "$cmd" == "app" ]] ; then
    initAudioVars
    b_silence execVMFunc "vm_app"
  else
    B_ERR="Invalid command: $cmd"
    B_E
  fi
}

main "$@"
